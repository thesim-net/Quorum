# Copy to .env and fill in. Never commit the filled-in file.
#
# On first boot the container prints a one-time setup link; open it to create
# the first admin account. Discord is NOT configured here either: connect your
# server from the Discord plugin's settings page, where credentials are stored
# encrypted in the database so they survive a redeploy.

# Public origin the site is served from, no trailing slash.
PUBLIC_URL=https://surveys.example.com
HTTP_PORT=8080

# Database
POSTGRES_DB=quorum
POSTGRES_USER=quorum
POSTGRES_PASSWORD=

# Secrets. Generate each with: openssl rand -hex 32
#
# SESSION_SECRET also derives the key that encrypts stored Discord credentials
# and 2FA secrets. Changing it signs everyone out AND makes those unreadable,
# which means reconnecting Discord and re-enrolling 2FA. Not a routine rotation.
SESSION_SECRET=
# Salts every respondent hash. Changing it detaches all existing responses
# from their authors, permanently.
RESPONDENT_PEPPER=

# Where the country lookup table is cached. It is compiled on first start from
# the five regional internet registries' own published allocation lists, so
# there is no account to create and no database to download by hand. Needs to
# be writable. Clearing it just forces a rebuild.
GEO_DATA_DIR=/data/geoip
# How often to refresh that table, in days.
GEO_REFRESH_DAYS=7

# How many proxies sit between the client and the API, counting only those that
# append to X-Forwarded-For. 1 is correct when the bundled nginx container is
# what the internet talks to. Add one for each reverse proxy you put in front
# of it. Too low and every response is attributed to your own proxy's address,
# which shows up as a location breakdown that is entirely Unknown; too high and
# a client could choose what address you read.
TRUST_PROXY_HOPS=1

# Which published version to run. Leave as latest, or pin to a version like
# 1.0.0. `docker compose pull` fetches this tag from GHCR.
QUORUM_VERSION=latest

# Update checking polls this GitHub repo's latest release to notify admins of a
# newer version. Set UPDATE_CHECK=off to disable the outbound request.
#UPDATE_CHECK=off
#UPDATE_CHECK_REPO=thomasloupe/Quorum

# Where uploaded file answers are stored inside the container. Backed by the
# `uploads` volume in docker-compose; you should not normally need to change it.
#UPLOADS_DIR=/data/uploads

# --- Optional overrides -----------------------------------------------------
#
# Setting ALL FOUR pins Discord configuration to the environment and makes the
# setup wizard read-only. Leave them unset to use the wizard instead.
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=

# Discord user ids that are always admins, regardless of setup.
#BOOTSTRAP_ADMIN_IDS=
# Discord role ids that grant admin access. The wizard can also set these.
#ADMIN_ROLE_IDS=
