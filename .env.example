# Copy to .env and fill in. Never commit the filled-in file.
#
# Discord is NOT configured here. On first boot the container prints a one-time
# setup link; open it and connect your server through the wizard. Credentials
# are stored encrypted in the database, so they survive a redeploy.

# Public origin the site is served from, no trailing slash.
PUBLIC_URL=https://surveys.example.com
HTTP_PORT=8080

# Database
POSTGRES_DB=quorum
POSTGRES_USER=quorum
POSTGRES_PASSWORD=

# Secrets. Generate each with: openssl rand -hex 32
#
# SESSION_SECRET also derives the key that encrypts stored Discord credentials.
# Changing it signs everyone out AND makes those credentials unreadable, which
# means running setup again. It is not a routine rotation.
SESSION_SECRET=
# Salts every respondent hash. Changing it detaches all existing responses
# from their authors, permanently.
RESPONDENT_PEPPER=

# Optional. Country-level metrics need a local MaxMind GeoLite2 Country
# database at ./data/geoip/GeoLite2-Country.mmdb. Without it the location
# toggle records nothing and everything else still works.
GEOIP_DB_PATH=/data/geoip/GeoLite2-Country.mmdb

# Proxies between the client and the API. 1 for the bundled nginx container.
TRUST_PROXY_HOPS=1

# Which published version to run. Leave as latest, or pin to a version like
# 1.0.0. `docker compose pull` fetches this tag from GHCR.
QUORUM_VERSION=latest

# Update checking polls this GitHub repo's latest release to notify admins of a
# newer version. Set UPDATE_CHECK=off to disable the outbound request.
#UPDATE_CHECK=off
#UPDATE_CHECK_REPO=thomasloupe/Quorum

# Where uploaded file answers are stored inside the container. Backed by the
# `uploads` volume in docker-compose; you should not normally need to change it.
#UPLOADS_DIR=/data/uploads

# --- Optional overrides -----------------------------------------------------
#
# Setting ALL FOUR pins Discord configuration to the environment and makes the
# setup wizard read-only. Leave them unset to use the wizard instead.
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=

# Discord user ids that are always admins, regardless of setup.
#BOOTSTRAP_ADMIN_IDS=
# Discord role ids that grant admin access. The wizard can also set these.
#ADMIN_ROLE_IDS=
